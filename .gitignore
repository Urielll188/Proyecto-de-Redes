*.key
*.p12
*.pfx
*.crt
*.der
*.keystore
id_rsa*
id_ed25519*
*secret*
*credentials*.json
*service-account*.json

# Local databases
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

